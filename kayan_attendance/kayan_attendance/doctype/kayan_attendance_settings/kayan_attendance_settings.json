 "fields": [
  {
   "fieldname": "watchdog_section",
   "fieldtype": "Section Break",
   "label": "Attendance Watchdog"
  },
  {
   "default": "1",
   "description": "Every 10 minutes, check employees who checked in and did not check out, and check them out automatically.",
   "fieldname": "enable_watchdog",
   "fieldtype": "Check",
   "label": "Enable Watchdog"
  },
  {
   "default": "17:00:00",
   "description": "Open check-ins are closed at this time on the day of the check-in.",
   "fieldname": "auto_checkout_time",
   "fieldtype": "Time",
   "label": "Automatic Check-out Time",
   "reqd": 1
  },
  {
   "default": "Fixed Time",
   "description": "Shift End uses the end of the employee's shift recorded on the check-in by Frappe HR, and the fixed time when there is no shift.",
   "fieldname": "checkout_time_based_on",
   "fieldtype": "Select",
   "label": "Check-out Time Based On",
   "options": "Fixed Time\nShift End"
  },
  {
   "fieldname": "column_break_watchdog",
   "fieldtype": "Column Break"
  },
  {
   "default": "0",
   "description": "Wait this many minutes after the check-out time before closing the check-in.",
   "fieldname": "grace_minutes",
   "fieldtype": "Int",
   "label": "Grace Minutes"
  },
  {
   "default": "3",
   "description": "How many past days of check-ins the watchdog looks at.",
   "fieldname": "lookback_days",
   "fieldtype": "Int",
   "label": "Look Back Days"
  },
  {
   "default": "2",
   "description": "For a check-in made after the check-out time (for example after an automatic check-out): it is closed this many hours later, and never after midnight.",
   "fieldname": "late_session_hours",
   "fieldtype": "Float",
   "label": "Late Session Hours"
  },
  {
   "fieldname": "extension_section",
   "fieldtype": "Section Break",
   "label": "Check-in Time Extension"
  },
  {
   "default": "1",
   "description": "Let employees stay checked in after the check-out time with an approved Check-in Time Extension.",
   "fieldname": "allow_extensions",
   "fieldtype": "Check",
   "label": "Allow Extensions"
  },
  {
   "default": "2",
   "depends_on": "allow_extensions",
   "fieldname": "default_extension_hours",
   "fieldtype": "Float",
   "label": "Default Extension Hours"
  },
  {
   "default": "4",
   "depends_on": "allow_extensions",
   "description": "Longest extension after the normal check-out time. 0 means no limit.",
   "fieldname": "max_extension_hours",
   "fieldtype": "Float",
   "label": "Maximum Extension Hours"
  },
  {
   "fieldname": "column_break_extension",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "depends_on": "allow_extensions",
   "description": "When an employee checks in again from the Frappe HR mobile app after an automatic check-out, raise a Check-in Time Extension for the default hours.",
   "fieldname": "request_extension_on_recheckin",
   "fieldtype": "Check",
   "label": "Request Extension on Re-check-in"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.allow_extensions && doc.request_extension_on_recheckin",
   "fieldname": "auto_approve_recheckin_extensions",
   "fieldtype": "Check",
   "label": "Approve Those Requests Automatically"
  },
  {
   "fieldname": "notification_section",
   "fieldtype": "Section Break",
   "label": "Notifications"
  },
  {
   "default": "1",
   "description": "Send a notification to the Frappe HR mobile app when the employee is checked out automatically and when an extension is approved or rejected.",
   "fieldname": "notify_employee",
   "fieldtype": "Check",
   "label": "Notify Employee"
  },
  {
   "fieldname": "column_break_notification",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "description": "Notify the shift request approver of new extension requests.",
   "fieldname": "notify_approver",
   "fieldtype": "Check",
   "label": "Notify Approver"
  },
  {
